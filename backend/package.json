{
  "name": "personal-blog-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shino's Bolg backend (Elysia + Drizzle + SQLite)",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "bun test",
    "migrate": "bun run src/scripts/migrate.ts",
    "seed": "bun run src/scripts/seed.ts",
    "import:frontend": "bun run src/scripts/import-from-frontend.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "drizzle-orm": "^0.44.7",
    "elysia": "^1.4.12",
    "gray-matter": "^4.0.3",
    "jose": "^6.1.0",
    "marked": "^17.0.4",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/sanitize-html": "^2.16.0",
    "typescript": "^5.9.3"
  }
}
