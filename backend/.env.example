# Runtime
NODE_ENV=production
PORT=3001

# Postgres connection (Rust backend; replaces DATABASE_PATH)
# 本地 PG：1Panel 面板管理实例（127.0.0.1:5432，库 blog-date，用户 shino）
#   示例：postgres://shino:<凭据位置>@127.0.0.1:5432/blog-date
# 生产云 PG：   postgres://user:pass@host:5432/shino_blog
DATABASE_URL=postgres://user:pass@host:5432/shino_blog

# Data paths (adjust to your server directory)
UPLOADS_ROOT=/opt/shino-blog/uploads

# Admin auth (MUST change before production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_JWT_SECRET=change-this-jwt-secret
ADMIN_JWT_EXPIRES_HOURS=24
