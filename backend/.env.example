# Runtime
NODE_ENV=production
PORT=3001

# Data paths inside container (bind to host volumes in 1Panel)
DATABASE_PATH=/app/data/blog.sqlite
UPLOADS_ROOT=/app/uploads

# Admin auth (MUST change before production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_JWT_SECRET=change-this-jwt-secret
ADMIN_JWT_EXPIRES_HOURS=24
